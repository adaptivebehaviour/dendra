{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "fastapi: run",
      "type": "shell",
      "command": "python main.py",
      "isBackground": true,
      "problemMatcher": {
        "owner": "fastapi",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Started server process",
          "endsPattern": "Application startup complete"
        }
      }
    }
  ]
}
